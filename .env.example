# Copy to .env and fill in. NEVER commit .env.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB
SECRET_KEY=generate-with-python-cryptography-Fernet-generate_key
BASE_URL=https://your-vps-domain
DATABASE_URL=postgresql+asyncpg://wow:wow@postgres:5432/wow
SIMC_IMAGE_TAG=latest
# pinned digest (update together with the tag):
# simulationcraftorg/simc@sha256:80ff504e8e65689741616a482f370e88ce25f07cf3e840da7480afc9006253e6
SIMC_PATH=/usr/local/bin/simc
REPORT_PATH=/data/reports
RAID_SIM_ITERATIONS=10000
MPLUS_SIM_ITERATIONS=10000
RAID_TARGET_ERROR=0.002
MPLUS_TARGET_ERROR=0.002
